# --- Telegram ---
BOT_TOKEN=
ADMIN_CHAT_IDS=123456789,987654321
EMERGENCY_PHONE=+7XXXXXXXXXX

# --- Database ---
# Локально можно оставить ./data/bot.db. В Docker путь монтируется как volume.
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# --- Google Sheets: плоский лог заявок (сценарии 2-9) ---
# Если GOOGLE_SHEET_ID пуст — синхронизация с таблицей отключается, бот работает как обычно.
GOOGLE_SHEET_ID=
GOOGLE_CREDENTIALS_PATH=./credentials.json

# --- Google Sheets: реальная таблица расписания зала (сценарий 1) ---
# Отдельная таблица с одним листом на день («31.08 ПН» и т.п.) — ФИО пишется
# прямо в ячейку [слот x аппарат]. Тот же service account должен быть Editor'ом
# и на ней. Если GYM_SCHEDULE_SHEET_ID пуст — запись в зал недоступна.
GYM_SCHEDULE_SHEET_ID=
GYM_TEMPLATE_WEEKDAY=копия пн-пт
GYM_TEMPLATE_SATURDAY=копия сб
GYM_APPARATUS_COUNT=8

# --- Расписание записи ---
TIMEZONE=Asia/Almaty
BOOKING_HORIZON_DAYS=14
WORKING_DAYS=1,2,3,4,5,6          # 1=Пн ... 7=Вс
# Сеансовая сетка времени (12 слотов "10:10 - 10:40" …) — общая для зала и
# инструктора, зашита в bot/services/gym_sheet.py (факт о клинике, не настройка).
INSTRUCTOR_SLOTS_PER_HOUR=2       # макс. записей к инструктору на один сеанс

# --- Прочее ---
LOG_LEVEL=INFO
SHEET_SYNC_INTERVAL_SECONDS=30
SHEET_SYNC_MAX_ATTEMPTS=20
